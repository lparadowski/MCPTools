# Trello — https://trello.com/power-ups/admin
TRELLO_API_KEY=
TRELLO_TOKEN=

# Jira — https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# Confluence — same Atlassian credentials as Jira
CONFLUENCE_BASE_URL=https://your-domain.atlassian.net/wiki
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=

# Miro — https://miro.com/app/settings/user-profile/apps
MIRO_ACCESS_TOKEN=

# Azure DevOps — https://dev.azure.com (generate a Personal Access Token under User Settings)
AZURE_DEVOPS_ORGANIZATION=
AZURE_DEVOPS_PAT=

# GitHub — https://github.com/settings/tokens (generate a Personal Access Token)
GITHUB_TOKEN=

# Octopus Deploy — server URL + an API key (User Profile → API Keys, format API-XXXXXXXX).
# OCTOPUS_SPACE is optional; leave blank to use the default space.
OCTOPUS_SERVER_URL=https://your-octopus-instance
OCTOPUS_API_KEY=
OCTOPUS_SPACE=

# SSL validation — set to true if behind a corporate proxy that intercepts HTTPS
# with a custom root CA. Only use in development environments.
DISABLE_SSL_VALIDATION=false

# RabbitMQ — for monitoring queues during dev. Tools will fail at call time if
# the broker isn't reachable; no startup check.
RABBITMQ_URI=amqp://guest:guest@host.docker.internal:5672/
RABBITMQ_MANAGEMENT_URI=http://host.docker.internal:15672
RABBITMQ_MANAGEMENT_USERNAME=guest
RABBITMQ_MANAGEMENT_PASSWORD=guest
RABBITMQ_VHOST=/
